# Copy to .env.production and fill in. Never commit it.

# Public web address (change domain here, no code edits needed)
APP_URL=https://removalworksolution.online

# Backend (database + sign-in). URL and publishable key are public values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=YOUR-PROJECT
# Direct Postgres connection — used ONLY by scripts/migrate.sh and scripts/backup.sh
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Sign-in tokens are issued and signed by the backend; AUTH_SECRET is reserved for future cookie signing.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Google Places API (New). Leave empty until ready — app shows GOOGLE_API_NOT_CONFIGURED.
GOOGLE_MAPS_API_KEY=

# AI review analysis (Lovable AI Gateway key)
LOVABLE_API_KEY=
# Alias kept for documentation; the app reads LOVABLE_API_KEY.
AI_PROVIDER_KEY=
